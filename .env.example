# Copy to .env.local (git-ignored) and fill in from
# Supabase dashboard > Project Settings > API (project ref qzaijqrkriuhlqbwmyto).
# Only the public anon key goes here; never put the service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://qzaijqrkriuhlqbwmyto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: the deployed web app's origin (e.g. https://app.stashtag.ai). Shared-list links made on a phone point
# there so friends without the app can open them; without it they use stashtag:// and need the app installed.
EXPO_PUBLIC_WEB_URL=
