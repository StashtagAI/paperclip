{
  "expo": {
    "name": "StashtagAI",
    "slug": "stashtag",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/53c50a71-a627-4beb-94bc-e77360d022e9"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stashtag",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "ai.stashtag.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.stashtag.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F6FEB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F9FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#0A1420",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Stashtag",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stashtag reads the screenshots and screen recordings you pick to find the text of a post. They stay on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stashtag uses your location to tell you when you're near a place you saved. It never leaves your phone.",
          "locationAlwaysAndWhenInUsePermission": "Allow “Always” so Stashtag can nudge you about saved places nearby while the app is closed. Your location never leaves your phone.",
          "locationAlwaysPermission": "Allow “Always” so Stashtag can nudge you about saved places nearby while the app is closed. Your location never leaves your phone.",
          "locationFullAccuracyPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "53c50a71-a627-4beb-94bc-e77360d022e9"
      }
    }
  }
}
